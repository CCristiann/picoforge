"""
A priority queue implementation using a heap-based approach.

This module provides a generic priority queue that supports:
- Inserting items with associated priorities
- Removing and returning the highest-priority item
- Checking if the queue is empty
- Getting the size of the queue
- Peeking at the highest-priority item without removing it

The priority queue uses a min-heap internally, so lower priority values
are dequeued first. For max-priority behavior, negate the priority values.
"""

import heapq
import unittest
from typing import Any, Optional, Tuple, List


class PriorityQueue:
    """
    A generic priority queue implemented using a binary heap.

    Items are stored as (priority, item) tuples. Lower priority values
    are dequeued first (min-heap behavior). For max-priority behavior,
    use negative priority values.

    Attributes:
        _heap: The internal list representing the heap.
        _counter: A monotonically increasing counter to break ties
                  and ensure FIFO order for equal priorities.
    """

    def __init__(self) -> None:
        """Initialize an empty priority queue."""
        self._heap: List[Tuple[int, int, Any]] = []
        self._counter: int = 0

    def push(self, item: Any, priority: int) -> None:
        """
        Insert an item with the given priority into the queue.

        Args:
            item: The item to enqueue.
            priority: An integer representing the priority.
                      Lower values indicate higher priority.
        """
        entry = (priority, self._counter, item)
        self._counter += 1
        heapq.heappush(self._heap, entry)

    def pop(self) -> Any:
        """
        Remove and return the highest-priority item from the queue.

        Returns:
            The item with the lowest priority value.

        Raises:
            IndexError: If the queue is empty.
        """
        if not self._heap:
            raise IndexError("pop from an empty priority queue")
        _, _, item = heapq.heappop(self._heap)
        return item

    def peek(self) -> Any:
        """
        Return the highest-priority item without removing it.

        Returns:
            The item with the lowest priority value.

        Raises:
            IndexError: If the queue is empty.
        """
        if not self._heap:
            raise IndexError("peek from an empty priority queue")
        _, _, item = self._heap[0]
        return item

    def is_empty(self) -> bool:
        """
        Check whether the queue is empty.

        Returns:
            True if the queue contains no items, False otherwise.

